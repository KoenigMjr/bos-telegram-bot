# Nur nötig, wenn du docker compose auf der Kommandozeile nutzt: als ".env"
# neben die docker-compose.yml legen, compose liest sie automatisch.
# In Portainer stattdessen dieselben Namen unter "Environment variables" eintragen.

# Pflicht
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_GHIJKLMNOPQRSTUVWXYZ
ADMIN_USERS=123456789
MQTT_HOST=192.168.1.100

# Optional - leer/auskommentiert lassen, dann gelten die Standardwerte
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC=homeassistant/boswatch/alarm/+

# Nur für die Namens-Suche (/ric, /description), siehe README
# CSV_PATH_RIC=/boswatch3-config/descriptions_ric.csv
# CSV_PATH_DESCRIPTION=/boswatch3-config/descriptions_ric.csv
